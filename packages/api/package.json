{
  "name": "@governance/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "governance:sync": "node scripts/sync-governance.mjs"
  },
  "dependencies": {
    "@cedar-policy/cedar-wasm": "4.13.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/websocket": "^10.0.0",
    "@governance/shared": "workspace:*",
    "ajv": "^8.20.0",
    "drizzle-orm": "^0.33.0",
    "fastify": "^4.28.0",
    "nanoid": "^5.0.0",
    "postgres": "^3.4.0",
    "yaml": "^2.9.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "drizzle-kit": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  }
}
